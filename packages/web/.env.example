# URL base de la API.
# En desarrollo el proxy de Vite ya redirige /api a http://localhost:3000,
# así que este archivo no es necesario para `npm run dev:web`.
#
# En producción (Netlify) define VITE_API_URL en el panel del sitio, por ejemplo:
#   VITE_API_URL=https://tu-backend.example.com/api
VITE_API_URL=/api
