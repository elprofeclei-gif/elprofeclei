# Copia este archivo como .env y completa los valores.
# La API valida estas variables al arrancar y no inicia si falta alguna obligatoria.

PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elprofeclei?schema=public

# Claves de firma (mínimo 10 caracteres cada una).
# Genera valores reales con: openssl rand -base64 48
# NUNCA subas el archivo .env al repositorio.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173

# Cookie del refresh token.
# Si el frontend y la API quedan en dominios distintos, usa COOKIE_SAMESITE=none
# y COOKIE_SECURE=true (el navegador exige HTTPS en ese caso).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.tudominio.com
REFRESH_TOKEN_TTL_DAYS=7

# Secreto propio para los tokens QR de asistencia (opcional; si se omite se usa JWT_ACCESS_SECRET)
QR_TOKEN_SECRET=

# Base del frontend: se usa para armar los enlaces de los correos
# (por ejemplo el de recuperación de contraseña). Por defecto http://localhost:5173
FRONTEND_URL=

# --- Correo saliente -------------------------------------------------------
# 'none' (por defecto) no envía nada: el contenido del correo queda en el log,
# con el enlace de recuperación incluido. Para envío real usa 'resend' o
# 'sendgrid' y define además el remitente verificado y la clave del proveedor.
# Paso a paso en docs/configurar-correo.md
MAIL_PROVIDER=none
MAIL_FROM=
MAIL_FROM_NAME=elprofeclei
RESEND_API_KEY=
SENDGRID_API_KEY=

# Número de proxies delante de la API (1 en Netlify/Render): afecta a req.ip
TRUST_PROXY=0

# Rate limiting en memoria
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
